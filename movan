  © 2026 SPOR MOVAN - جميع الحقوق محفوظة
</footer><script>
  function sendWhatsApp(event, productName){
    event.preventDefault();

    const form = event.target;

    const name = form.querySelector('input[type="text"]').value;
    const phone = form.querySelector('input[type="tel"]').value;
    const address = form.querySelector('textarea').value;
    const color = form.querySelectorAll('select')[0].value;
    const size = form.querySelectorAll('select')[1].value;

    const message = `🛍️ طلب جديد من متجر SPOR MOVAN\n\n📦 المنتج: ${productName}\n🎨 اللون: ${color}\n📏 المقاس: ${size}\n👤 الاسم: ${name}\n📱 الهاتف: ${phone}\n📍 العنوان: ${address}`;

    const whatsappURL = `https://wa.me/212648460893?text=${encodeURIComponent(message)}`;

    window.open(whatsappURL, '_blank');
  }
</script></body>
</html>
