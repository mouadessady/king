<!DOCTYPE html><html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SPOR MOVAN</title>  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:'Cairo',sans-serif;
      scroll-behavior:smooth;
    }

    body{
      background:#000;
      color:#fff;
    }

    header{
      position:fixed;
      top:0;
      width:100%;
      background:#000000dd;
      backdrop-filter:blur(10px);
      z-index:1000;
      border-bottom:1px solid #222;
    }

    .container{
      width:90%;
      max-width:1200px;
      margin:auto;
    }

    nav{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:20px 0;
    }

    .logo{
      font-size:32px;
      font-weight:900;
      color:#00ff88;
      letter-spacing:3px;
    }

    nav ul{
      display:flex;
      gap:25px;
      list-style:none;
    }

    nav ul li a{
      color:white;
      text-decoration:none;
      font-size:18px;
      transition:0.3s;
    }

    nav ul li a:hover{
      color:#00ff88;
    }

    .hero{
      height:100vh;
      background:url('https://images.unsplash.com/photo-1518611012118-696072aa579a?q=80&w=1600&auto=format&fit=crop') center/cover;
      display:flex;
      justify-content:center;
      align-items:center;
      text-align:center;
      position:relative;
    }

    .hero::after{
      content:'';
      position:absolute;
      inset:0;
      background:#000000b5;
    }

    .hero-content{
      position:relative;
      z-index:2;
      width:90%;
    }

    .hero h1{
      font-size:70px;
      margin-bottom:20px;
      font-weight:900;
    }

    .hero h1 span{
      color:#00ff88;
    }

    .hero p{
      font-size:22px;
      color:#ddd;
      margin-bottom:35px;
    }

    .btn{
      display:inline-block;
      background:#00ff88;
      color:#000;
      padding:15px 35px;
      border-radius:40px;
      text-decoration:none;
      font-size:20px;
      font-weight:700;
      transition:0.3s;
    }

    .btn:hover{
      transform:scale(1.05);
    }

    section{
      padding:100px 0;
    }

    .section-title{
      text-align:center;
      margin-bottom:60px;
    }

    .section-title h2{
      font-size:50px;
      color:#00ff88;
      margin-bottom:10px;
    }

    .products{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
      gap:30px;
    }

    .product-card{
      background:#111;
      border-radius:25px;
      overflow:hidden;
      transition:0.4s;
      border:1px solid #222;
      box-shadow:0 10px 30px rgba(0,0,0,0.4);
    }

    .product-card:hover{
      transform:translateY(-10px);
    }

    .product-card img{
      width:100%;
      height:350px;
      object-fit:cover;
    }

    .product-content{
      padding:25px;
    }

    .product-content h3{
      font-size:28px;
      margin-bottom:10px;
    }

    .price{
      color:#00ff88;
      font-size:30px;
      font-weight:900;
      margin-bottom:20px;
    }

    .details{
      margin-bottom:20px;
      background:#000;
      padding:15px;
      border-radius:15px;
      border:1px solid #222;
    }

    .details p{
      margin-bottom:10px;
      color:#ddd;
      line-height:1.8;
    }

    .colors,
    .sizes{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin:15px 0;
    }

    .tag{
      background:#00ff88;
      color:#000;
      padding:7px 14px;
      border-radius:30px;
      font-size:14px;
      font-weight:bold;
    }

    .order-form{
      margin-top:20px;
    }

    .order-form input,
    .order-form select,
    .order-form textarea{
      width:100%;
      padding:14px;
      margin-bottom:15px;
      border:none;
      border-radius:12px;
      background:#1b1b1b;
      color:#fff;
      font-size:16px;
    }

    .order-form button{
      width:100%;
      padding:15px;
      border:none;
      border-radius:14px;
      background:#00ff88;
      color:#000;
      font-size:20px;
      font-weight:800;
      cursor:pointer;
      transition:0.3s;
    }

    .order-form button:hover{
      transform:scale(1.03);
    }

    footer{
      text-align:center;
      padding:30px;
      border-top:1px solid #222;
      color:#999;
    }

    @media(max-width:768px){
      .hero h1{
        font-size:42px;
      }

      nav ul{
        display:none;
      }
    }
  </style></head>
